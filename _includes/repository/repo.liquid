{% if include.repository.repository %}
  {% assign repository = include.repository.repository %}
  {% assign description = include.repository.description %}
{% else %}
  {% assign repository = include.repository %}
  {% assign description = '' %}
{% endif %}

{% assign repo_url = repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2">
  <a class="repository-card" href="https://github.com/{{ repository }}">
    <span class="repository-card-heading">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      {% if show_owner -%}
        <span class="repository-card-owner">{{ repo_url[0] }}/</span>
      {%- endif %}
      <strong class="repository-card-title">{{ repo_url[1] }}</strong>
    </span>
    <span class="repository-card-description">{{ description }}</span>
    <span class="repository-card-link">View repository <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
  </a>
</div>
