<div class="repo p-2">
  <a class="repository-card repository-profile-card" href="https://github.com/{{ include.username }}">
    <span class="repository-card-icon" aria-hidden="true"><i class="fa-brands fa-github"></i></span>
    <span class="repository-card-content">
      <span class="repository-card-label">GitHub profile</span>
      <strong class="repository-card-title">@{{ include.username }}</strong>
      <span class="repository-card-description">View the public profile, repositories, and recent work on GitHub.</span>
      <span class="repository-card-link">Open profile <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
    </span>
  </a>
</div>
